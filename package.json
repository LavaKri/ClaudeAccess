{
  "name": "claude-access",
  "version": "0.1.0",
  "description": "Accessible web interface for claude -p, built for the JAWS screen reader",
  "private": true,
  "license": "MIT",
  "author": "Quentin Cosendey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinC/claude-access.git"
  },
  "keywords": [
    "claude-code",
    "accessibility",
    "screen-reader",
    "jaws",
    "a11y"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "start:mock": "node server/server.js --mock",
    "dev": "nodemon server/server.js",
    "dev:mock": "nodemon server/server.js --mock",
    "cli-mock": "node mock/cli-mock.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
